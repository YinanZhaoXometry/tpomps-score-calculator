# Firebase (Google 登入) — 填入 Firebase 專案設定後，將此檔複製為 .env.local
# Firebase console → 專案設定 → 一般 → 你的應用程式 → SDK 設定和設定
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 注意：後端專用設定（AI_BASE_URL / AI_MODEL / FIREBASE_PROJECT_ID）在 wrangler.toml 的
# [vars]，AI_API_KEY 密鑰在 .dev.vars（本機）或 Pages secret（部署），都不是 VITE_ 變數。
